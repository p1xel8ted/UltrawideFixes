<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="Environment.props" Condition="Exists('Environment.props')"/>

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <AssemblyName>TormentedSouls</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
        <RootNamespace>TormentedSouls</RootNamespace>
        <Version>0.1.5</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <OutputPath>$(ModsOutputPath)</OutputPath>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile"/>
        <PackageReference Remove="Resource.Embedder"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="$(Il2CppAssembliesPath)\*.dll">
            <HintPath>$(Il2CppAssembliesPath)\%(Filename)%(Extension)</HintPath>
        </Reference>
    </ItemGroup>

    <Import Project="..\zip.target"/>
</Project>
