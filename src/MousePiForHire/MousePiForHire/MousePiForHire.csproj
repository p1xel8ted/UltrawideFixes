<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="Environment.props" Condition="Exists('Environment.props')"/>
    <PropertyGroup>
        <TargetFramework>net481</TargetFramework>
        <Product>MOUSE P.I. For Hire Ultra-Wide</Product>
        <Version>0.1.0</Version>
        <AssemblyName>$(Product)</AssemblyName>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <OutputPath>$(BepInExPluginsPath)</OutputPath>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
        <Deterministic>true</Deterministic>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CS0618</NoWarn>
    </PropertyGroup>

    <Import Project="../zip.target"/>

    <ItemGroup>
        <PackageReference Remove="BepInEx.AssemblyPublicizer.MSBuild" />
<!--        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4">-->
<!--          <PrivateAssets>all</PrivateAssets>-->
<!--          <ExcludeAssets>runtime</ExcludeAssets>-->
<!--        </PackageReference>-->
    </ItemGroup>

    <!-- Local BepInEx libs (replaces the NuGet BepInEx.Core package). Including everything in
         libs\bepinex pulls Harmony / MonoMod / Mono.Cecil / BepInEx core all from one folder so we
         build against the exact runtime the player has installed.
         0Harmony20.dll is excluded because it's the legacy v2.0 compat shim; including it alongside
         the modern 0Harmony.dll causes CS0433 type-collision errors (both define HarmonyPatch,
         HarmonyPostfix, etc. in the same namespace). -->
    <ItemGroup>
        <Reference Include="$(MSBuildProjectDirectory)\..\libs\bepinex\*.dll"
                   Exclude="$(MSBuildProjectDirectory)\..\libs\bepinex\0Harmony20.dll">
            <HintPath>$(MSBuildProjectDirectory)\..\libs\bepinex\%(Filename)%(Extension)</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
      <Reference Include="$(StrippedLibs)\*.dll">
      <HintPath>$(StrippedLibs)\%(Filename)%(Extension)</HintPath>
      </Reference>
    </ItemGroup>

   

    <!-- Default all references to CopyLocal False -->
    <ItemDefinitionGroup>
        <Reference>
            <Private>False</Private>
        </Reference>
        <ProjectReference>
            <Private>False</Private>
        </ProjectReference>
        <PackageReference>
            <Private>False</Private>
        </PackageReference>
    </ItemDefinitionGroup>

</Project>