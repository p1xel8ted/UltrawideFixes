<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="Environment.props" Condition="Exists('Environment.props')" />
    <PropertyGroup>
        <TargetFramework>net481</TargetFramework>
        <Product>MOUSE P.I. For Hire Ultra-Wide</Product>
        <Version>0.1.0</Version>
        <AssemblyName>$(Product)</AssemblyName>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <OutputPath>$(BepInExPluginsPath)</OutputPath>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
        <Deterministic>true</Deterministic>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CS0618</NoWarn>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <Import Project="../zip.target" />

    <ItemGroup>
        <PackageReference Remove="BepInEx.AssemblyPublicizer.MSBuild" />
    </ItemGroup>
    
    <ItemGroup>
        <Reference Include="$(MSBuildProjectDirectory)\..\libs\bepinex\*.dll" Exclude="$(MSBuildProjectDirectory)\..\libs\bepinex\0Harmony20.dll">
            <HintPath>$(MSBuildProjectDirectory)\..\libs\bepinex\%(Filename)%(Extension)</HintPath>
        </Reference>
        <Reference Include="ConfigurationManager">
          <HintPath>$(MSBuildProjectDirectory)\..\libs\configmanager\ConfigurationManager.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
      <Reference Include="$(StrippedLibs)\*.dll">
      <HintPath>$(StrippedLibs)\%(Filename)%(Extension)</HintPath>
      </Reference>
    </ItemGroup>
    

    <!-- Default all references to CopyLocal False -->
    <ItemDefinitionGroup>
        <Reference>
            <Private>False</Private>
        </Reference>
        <ProjectReference>
            <Private>False</Private>
        </ProjectReference>
        <PackageReference>
            <Private>False</Private>
        </PackageReference>
    </ItemDefinitionGroup>

</Project>